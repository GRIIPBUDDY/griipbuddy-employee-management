# Compose interpolation inputs ONLY. Copy outside the checkout, chmod 600.
# Never load this file into the normal Next.js process; owner secrets are one-off tools only.
COMPOSE_PROJECT_NAME=griipbuddy-employee
# Select a free loopback port after inspecting the existing VPS. This value is an example.
APP_PORT=3100
APP_BASE_URL=https://griipbuddy.cloud
ALLOW_LOCAL_HTTP=false
AUTH_SECRET=replace-with-unique-random-hex-secret
EMPLOYEE_APP_IMAGE=replace-with-reviewed-image-at-sha256-digest
POSTGRES_DB=griipbuddy_employee
POSTGRES_USER=employee_owner
POSTGRES_PASSWORD=replace-with-unique-owner-hex-password
POSTGRES_APP_PASSWORD=replace-with-different-runtime-hex-password
# First installation only. Clear these after initial password change; never rerun on existing users.
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-unique-temporary-password

# Optional persistent-session policy (1–90 whole days). Normal sessions remain 12 hours.
REMEMBER_ME_DAYS=30
# Optional HTTPS email delivery adapter; required to enable production email changes.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
# Host development ONLY, never accepted by production (including local production Compose).
# ALLOW_DEV_EMAIL_PREVIEW=true
