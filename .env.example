# Later production: use .env.production.example and DEPLOYMENT.md after owner approval.
# Docker: copy to .env.compose.local and pass --env-file .env.compose.local.
# Host Next.js .env must contain only runtime variables, not owner/bootstrap secrets.
# Replace ALL placeholders before use.
# Generate each password as hex to avoid URL-encoding issues: openssl rand -hex 24
COMPOSE_PROJECT_NAME=griipbuddy-employee
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# Local Compose uses a production build on loopback HTTP; HTTPS remains mandatory otherwise.
ALLOW_LOCAL_HTTP=true
TZ=UTC
POSTGRES_DB=griipbuddy_employee
POSTGRES_USER=employee_owner
POSTGRES_PASSWORD=replace-owner-password
POSTGRES_APP_PASSWORD=replace-runtime-password
# Host development only: point at your dedicated local PostgreSQL runtime account.
# PostgreSQL is NOT published by the main Docker Compose configuration.
DATABASE_URL=postgresql://employee_runtime:replace-runtime-password@127.0.0.1:5432/griipbuddy_employee
# Host private file directory; Compose sets /app/private/documents on its dedicated volume.
PRIVATE_DOCUMENTS_DIR=/absolute/private/path/employee-documents
# One-off bootstrap command only, not injected into the normal app container.
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-temporary-password
# Pass MIGRATION_DATABASE_URL only to one-off migration/bootstrap tools.
