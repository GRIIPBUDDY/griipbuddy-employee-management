 @@index([employeeId,startDate,publishedAt])
 @@map("performance_reviews")
}
model DisciplinaryRecord {
 id String @id @default(uuid()) @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 employmentPeriodId String @map("employment_period_id") @db.Uuid
 issueDate DateTime @map("issue_date") @db.Date
 severity String @db.VarChar(20)
 reason String @db.VarChar(500)
 description String @db.VarChar(2000)
 actionTaken String @map("action_taken") @db.VarChar(2000)
 staffNotes String @map("staff_notes") @db.VarChar(2000)
 attachmentDocumentId String? @map("attachment_document_id") @db.Uuid
 employeeVisible Boolean @default(false) @map("employee_visible")
 acknowledgementRequested Boolean @default(false) @map("acknowledgement_requested")
 acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
 acknowledgedBy String? @map("acknowledged_by") @db.Uuid
 publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
 issuedBy String @map("issued_by") @db.Uuid
 publishedBy String? @map("published_by") @db.Uuid
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 revocationReason String? @map("revocation_reason") @db.VarChar(500)
 revision Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
